# Copy to backend/.env for local development. Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://worlddiscovery:worlddiscovery@postgres:5432/worlddiscovery
TEST_DATABASE_URL=postgresql+psycopg://worlddiscovery_test:worlddiscovery_test@postgres_test:5432/worlddiscovery_test

# Web OAuth client ID (public, not a secret) — audience expected in Google ID tokens.
GOOGLE_WEB_CLIENT_ID=348836152616-3pc7b17vm4osslku4r70475t4ames7l4.apps.googleusercontent.com

# Symmetric signing key for World Discovery access tokens (JWT). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changeme-generate-a-real-secret

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Symmetric key for hashing email OTP codes (HMAC-SHA256). Deliberately distinct from
# JWT_SECRET so a leak of one does not compromise the other. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_HASH_SECRET=changeme-generate-a-different-real-secret

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_EMAIL_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20

# Dev default: Mailpit (docker-compose service) — captures mail locally, never delivers
# it externally. Read the OTP code from Mailpit's web UI at http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_ADDRESS=no-reply@worlddiscovery.local
