<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer exclusion rules — see TrajectoryBufferDatabase's own doc
  comment (:core-database) for the full reasoning. Only the trajectory-reconstruction buffer
  (raw, short-lived GPS coordinates — an explicit, bounded, documented exception to this app's
  "never persist raw GPS" default — see docs/ai-context/LOCATION_TRACKING.md) is excluded here.
  world_discovery.db (discovered_cells, the canonical discovery history) is deliberately left
  eligible for backup, unchanged from this app's existing behavior before this file existed.

  Excludes all of the database file's own WAL-mode companion files (Room's default journal mode),
  not just the primary file, since a WAL/SHM file can itself carry recently-written row content
  that has not yet been checkpointed into the main file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="trajectory_buffer.db" />
        <exclude domain="database" path="trajectory_buffer.db-wal" />
        <exclude domain="database" path="trajectory_buffer.db-shm" />
        <exclude domain="database" path="trajectory_buffer.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="trajectory_buffer.db" />
        <exclude domain="database" path="trajectory_buffer.db-wal" />
        <exclude domain="database" path="trajectory_buffer.db-shm" />
        <exclude domain="database" path="trajectory_buffer.db-journal" />
    </device-transfer>
</data-extraction-rules>
